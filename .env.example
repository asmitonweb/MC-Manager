HOST=0.0.0.0
PORT=3000
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
USER_PASSWORD=replace-with-a-long-unique-user-password
SESSION_SECRET=replace-with-a-long-random-session-secret
SUPERVISOR_TOKEN=replace-with-a-long-random-tray-token
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=replace-with-the-server-rcon-password

# Windows runtime settings
JAVA_BIN=C:/Program Files/Eclipse Adoptium/jdk-25.0.4.101-hotspot/bin/java.exe
MC_SERVER_DIR=E:/MC PC - Sandbox/server
MC_SERVER_JAR=fabric-server.jar
MC_SERVER_PROPERTIES=server.properties
MC_MIN_MEMORY=2G
MC_MAX_MEMORY=6G
MAP_TARGET=http://127.0.0.1:8100

# Leave blank for same-origin access. Add the Vite origin when using the dev server.
CORS_ORIGIN=
