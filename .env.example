HOST=0.0.0.0
PORT=3000
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
USER_PASSWORD=replace-with-a-long-unique-user-password
SESSION_SECRET=replace-with-a-long-random-session-secret
SUPERVISOR_TOKEN=replace-with-a-long-random-tray-token

# Paths. Defaults are relative to the folder above mc-manager (the sandbox root).
MC_SERVER_DIR=E:/MC PC - Sandbox/server
MC_SERVER_PROPERTIES=server.properties
# BACKUP_DIR=E:/MC PC - Sandbox/backups
# MANAGER_DATA_DIR=E:/MC PC - Sandbox/manager-data

# Fallbacks, used only when the server was not installed through the Server page.
# An installed server keeps its own Java, launch command and memory in its profile,
# and RCON settings are read from server.properties.
JAVA_BIN=C:/Program Files/Eclipse Adoptium/jdk-25.0.4.101-hotspot/bin/java.exe
MC_SERVER_JAR=fabric-server.jar
MC_MIN_MEMORY=2G
MC_MAX_MEMORY=6G
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=replace-with-the-server-rcon-password


# Mod providers. Modrinth needs no key. CurseForge stays disabled until a key
# from https://console.curseforge.com is set; it is never sent to the browser.
CURSEFORGE_API_KEY=
# MODRINTH_USER_AGENT=asmitonweb/MC-Manager/1.1 (github.com/asmitonweb/MC-Manager)

# Leave blank for same-origin access. Add the Vite origin when using the dev server.
CORS_ORIGIN=
